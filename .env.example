# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM (the only provider wired up for now) ---
LLM_PROVIDER=gemini
# Free-tier daily quota matters a lot: 3.x *-flash = 20 req/day (too small);
# *-flash-lite = 500 req/day. Use flash-lite for real investigation workloads.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Optional overrides
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_TEMPERATURE=0.1

# --- Infra (defaults work for the Windows host talking to the docker-compose stack) ---
# PG_HOST=localhost
# OS_HOST=localhost
# AIRFLOW_BASE_URL=http://localhost:8080
# AIRFLOW_USER=admin
# AIRFLOW_PASSWORD=admin
